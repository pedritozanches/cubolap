  <MdxScripts>
    <MdxScript dwd:design-time-name="aab05758-aca8-4aad-87f2-1ba88f9b31a9">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
El comando CALCULATE controla la agregación de celdas hoja en el cubo.
Si se elimina o modifica el comando CALCULATE, se ven afectados los datos del cubo.
Solo debe editar este comando si especifica manualmente cómo se agrega el cubo.
*/
CALCULATE; 
CREATE MEMBER CURRENTCUBE.[Measures].Ventas_Anio_Anterior
 AS CoalesceEmpty(
    (
        ParallelPeriod(
            [Dim Time].[Calendario].[Year], 
            1, 
            [Dim Time].[Calendario].CurrentMember
        ),
        [Measures].[Total Sale]
    ),
    [Measures].[Total Sale]
), 
FORMAT_STRING = "Standard", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].Crecimiento_YToY
 AS IIF(
    IsEmpty([Measures].[Ventas_Anio_Anterior]) OR [Measures].[Ventas_Anio_Anterior] = 0,
    NULL,
    ([Measures].[Total Sale] - [Measures].[Ventas_Anio_Anterior]) / [Measures].[Ventas_Anio_Anterior]
), 
FORMAT_STRING = "Percent", 
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>